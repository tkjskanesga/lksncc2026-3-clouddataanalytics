{
  "Comment": "NusaCommerce Pipeline Orchestrator — 9 States. Required input: bucket, key, timestamp, emr_cluster_id, sns_topic_arn, processed_bucket, curated_bucket.",
  "StartAt": "ValidateInput",
  "States": {
    "ValidateInput": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "nusa-validate-input",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.validation",
      "Next": "ParallelETL",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "ParallelETL": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "ETLTransactions",
          "States": {
            "ETLTransactions": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "nusa-etl-transaction"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "ETLShipments",
          "States": {
            "ETLShipments": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "nusa-etl-shipments"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "ETLSellers",
          "States": {
            "ETLSellers": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "nusa-etl-sellers"
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.etl_results",
      "Next": "RunCrawler",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ]
    },
    "RunCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "nusa-crawler-raw"
      },
      "ResultPath": "$.crawler_result",
      "Next": "PostProcessing",
      "Retry": [
        {
          "ErrorEquals": ["Glue.CrawlerRunningException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ]
    },
    "ParallelPostProcessing": {
      "Type": "Parallel",
      "Comment": "Branch 1: Redshift load then refresh views. Branch 2: EMR seller scoring then user segmentation.",
      "Branches": [
        {
          "StartAt": "LoadToRedshift",
          "States": {
            "LoadToRedshift": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "nusa-redshift-loader",
                "Payload.$": "$"
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.redshift_result",
              "Next": "RefreshViews",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ]
            },
            "RefreshViews": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "nusa-view-refresher",
                "Payload.$": "$"
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.refresh_result",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ]
            }
          }
        },
        {
          "StartAt": "RunEMRSellerScoring",
          "States": {
            "RunEMRSellerScoring": {
              "Type": "Task",
              "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
              "Parameters": {
                "ClusterId.$": "$.emr_cluster_id",
                "Step": {
                  "Name": "SellerScoring",
                  "ActionOnFailure": "CONTINUE",
                  "HadoopJarStep": {
                    "Jar": "command-runner.jar",
                    "Args.$": "States.Array('spark-submit', '--master', 'yarn', '--deploy-mode', 'client', States.Format('s3://{}/scripts/emr_seller_scoring.py', $.bucket), '--transactions_path', States.Format('s3://{}/transactions/', $.processed_bucket), '--sellers_path', States.Format('s3://{}/sellers/', $.processed_bucket), '--output_path', States.Format('s3://{}/ml-features/seller-scores/', $.curated_bucket))"
                  }
                }
              },
              "ResultPath": "$.emr_seller_result",
              "Next": "RunEMRUserSegmentation",
              "Retry": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 1,
                  "BackoffRate": 2
                }
              ]
            },
            "RunEMRUserSegmentation": {
              "Type": "Task",
              "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
              "Parameters": {
                "ClusterId.$": "$.emr_cluster_id",
                "Step": {
                  "Name": "UserSegmentation",
                  "ActionOnFailure": "CONTINUE",
                  "HadoopJarStep": {
                    "Jar": "command-runner.jar",
                    "Args.$": "States.Array('spark-submit', '--master', 'yarn', '--deploy-mode', 'client', States.Format('s3://{}/scripts/emr/emr_user_segmentation.py', $.bucket), '--transactions_path', States.Format('s3://{}/transactions/', $.processed_bucket), '--output_path', States.Format('s3://{}/ml-features/user-segments/', $.curated_bucket))"
                  }
                }
              },
              "ResultPath": "$.emr_user_result",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 1,
                  "BackoffRate": 2
                }
              ]
            }
          }
        }
      ],
      "ResultPath": "$.post_processing_results",
      "Next": "LoadMLFeatures",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ]
    },
    "LoadMLFeatures": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "nusa-ml-loaders",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.ml_load_result",
      "Next": "NotifySuccess",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.sns_topic_arn",
        "Subject": "NusaCommerce Pipeline - SUCCEEDED",
        "Message.$": "States.Format('Pipeline execution {} completed successfully at {}.', $$.Execution.Name, $$.Execution.StartTime)"
      },
      "ResultPath": "$.sns_result",
      "Next": "Success",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Success",
          "ResultPath": "$.sns_error"
        }
      ]
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.sns_topic_arn",
        "Subject": "NusaCommerce Pipeline - FAILED",
        "Message.$": "States.Format('Pipeline execution {} FAILED at {}. Error: {}', $$.Execution.Name, $$.Execution.StartTime, States.JsonToString($.error))"
      },
      "Next": "Failure",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failure"
        }
      ]
    },
    "Success": {
      "Type": "Succeed"
    },
    "Failure": {
      "Type": "Fail",
      "Error": "PipelineExecutionFailed",
      "Cause": "One or more pipeline stages failed. Check CloudWatch logs."
    }
  }
}
